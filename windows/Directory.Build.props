<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <YikzVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\VERSION'))</YikzVersionFile>
    <YikzVersion Condition="Exists('$(YikzVersionFile)')">$([System.IO.File]::ReadAllText('$(YikzVersionFile)').Trim())</YikzVersion>
    <YikzVersion Condition="'$(YikzVersion)' == ''">0.0.0</YikzVersion>
    <Version Condition="'$(Version)' == ''">$(YikzVersion)</Version>
    <Company>yikz</Company>
    <Product>Yikz Clipboard</Product>
    <Copyright>Copyright (c) yikz</Copyright>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
